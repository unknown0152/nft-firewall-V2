#!/bin/sh
set -eu

PREREQ=
prereqs() {
    echo "$PREREQ"
}
case "${1:-}" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

rules=/etc/nftfw/initramfs-guard.nft
digest=/etc/nftfw/initramfs-guard.sha256
marker=/etc/nftfw/initramfs-managed-disabled-v1

block_boot() {
    message='NFTFW initramfs guard failed; non-loopback networking remains blocked'
    printf '%s\n' "$message" >/dev/kmsg 2>/dev/null || true
    printf '%s\n' "$message" >/dev/console 2>/dev/null || true
    while :; do
        sleep 60
    done
}

test -r "$marker" -a -r "$rules" -a -r "$digest" || block_boot
test "$(cat "$marker")" = 'nftfw.initramfs-managed-disabled.v1' || block_boot

# Built-in and early-probed NICs can precede init-top. Managed disabled mode
# therefore requires the transaction-owned pre-driver kernel argument. Refuse
# missing, quoted, duplicated, or contradictory identities, and never attempt
# to re-enable loopback while the kernel-wide disable is active.
test -r /proc/cmdline -a -r /sys/module/ipv6/parameters/disable || block_boot
set -f
managed_ipv6_disable=0
cmdline=$(cat /proc/cmdline) || block_boot
# Intentional kernel-command-line word splitting with pathname expansion off.
# shellcheck disable=SC2086
set -- $cmdline
for token do
    case "$token" in
        ipv6.disable=1) managed_ipv6_disable=$((managed_ipv6_disable + 1)) ;;
        ipv6.disable|ipv6.disable=*|*ipv6.disable=1*) block_boot ;;
    esac
done
set +f
test "$managed_ipv6_disable" -eq 1 || block_boot
case "$(cat /sys/module/ipv6/parameters/disable)" in
    Y|1) ;;
    *) block_boot ;;
esac
test ! -s /proc/net/if_inet6 || block_boot

expected=$(awk 'NR == 1 { print $1 }' "$digest")
actual=$(sha256sum "$rules" | awk '{ print $1 }')
test -n "$expected" -a "$actual" = "$expected" || block_boot

modprobe nf_tables >/dev/null 2>&1 || block_boot
nft --check --file "$rules" >/dev/null 2>&1 || block_boot
nft --file "$rules" >/dev/null 2>&1 || block_boot
nft list table inet nftfw_initramfs_guard >/dev/null 2>&1 || block_boot
install -d -m 0700 /run/nftfw-initramfs
printf '%s\n' "$actual" >/run/nftfw-initramfs/guard-ready.sha256
chmod 0600 /run/nftfw-initramfs/guard-ready.sha256
# Fixed, non-sensitive serial evidence lets the disposable boot gate bind the
# first physical packet to the instant the pre-driver IPv6 proof and temporary
# nftables guard have both completed. Never include paths, hashes, addresses,
# kernel arguments, or administrator data in this marker.
ready_message='NFTFW initramfs guard ready'
printf '%s\n' "$ready_message" >/dev/kmsg 2>/dev/null || true
printf '%s\n' "$ready_message" >/dev/console 2>/dev/null || true
# Headless validation guests may keep /dev/console on the virtual display.
# Mirror the same fixed marker to an optional first serial console; absence or
# write failure is non-fatal and cannot change the enforcement boundary.
printf '%s\n' "$ready_message" >/dev/ttyS0 2>/dev/null || true
