#!/bin/sh
set -eu

PREREQ=
prereqs() {
    echo "$PREREQ"
}
case "${1:-}" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

marker=/etc/nftfw/initramfs-managed-disabled-v1
owner=/etc/nftfw/initramfs-source-owner-v1
loader=/usr/lib/nftfw/initramfs/nftfw-ipv6-early
gate=/usr/lib/nftfw/initramfs/nftfw-udev-gate
rules=/usr/lib/nftfw/initramfs/nftfw-initramfs-guard.nft
source_loader=/etc/initramfs-tools/scripts/init-top/nftfw-ipv6-early
source_gate=/etc/initramfs-tools/scripts/init-top/udev
vendor_udev=/usr/share/initramfs-tools/scripts/init-top/udev
vendor_alias=nftfw-udev-vendor

test -e "$marker" || exit 0
test -f "$marker" -a ! -L "$marker" -a "$(stat -c '%a:%u:%g:%h' "$marker")" = 600:0:0:1
test "$(cat "$marker")" = 'nftfw.initramfs-managed-disabled.v1'
test -f "$owner" -a ! -L "$owner" -a "$(stat -c '%a:%u:%g:%h' "$owner")" = 600:0:0:1
for input in "$loader" "$gate" "$rules" "$source_loader" "$source_gate" "$vendor_udev"; do
    test -f "$input" -a ! -L "$input"
    test "$(stat -c '%u:%g:%h' "$input")" = 0:0:1
    test -z "$(find "$input" -maxdepth 0 -type f -perm /022 -print -quit)"
done
test -x "$loader" -a -x "$gate" -a -x "$source_loader" -a -x "$source_gate" -a -x "$vendor_udev"
test ! -e "/etc/initramfs-tools/scripts/init-top/$vendor_alias" \
    -a ! -L "/etc/initramfs-tools/scripts/init-top/$vendor_alias"
test ! -e "/usr/share/initramfs-tools/scripts/init-top/$vendor_alias" \
    -a ! -L "/usr/share/initramfs-tools/scripts/init-top/$vendor_alias"
loader_hash=$(sha256sum "$loader" | awk '{print $1}')
gate_hash=$(sha256sum "$gate" | awk '{print $1}')
test "$(sha256sum "$source_loader" | awk '{print $1}')" = "$loader_hash"
test "$(sha256sum "$source_gate" | awk '{print $1}')" = "$gate_hash"
test "$(cat "$owner")" = "nftfw.initramfs-source-owner.v1
loader_sha256=$loader_hash
gate_sha256=$gate_hash"

# shellcheck source=/dev/null
. /usr/share/initramfs-tools/hook-functions
manual_add_modules nf_tables
copy_exec /usr/sbin/nft /usr/sbin
copy_exec /usr/bin/sha256sum /usr/bin
copy_exec /usr/bin/stat /usr/bin
copy_exec /usr/bin/install /usr/bin
staged_loader="$DESTDIR/scripts/init-top/nftfw-ipv6-early"
staged_gate="$DESTDIR/scripts/init-top/udev"
test -f "$staged_loader" -a ! -L "$staged_loader" -a -x "$staged_loader"
test -f "$staged_gate" -a ! -L "$staged_gate" -a -x "$staged_gate"
test "$(sha256sum "$staged_loader" | awk '{print $1}')" = "$loader_hash"
test "$(sha256sum "$staged_gate" | awk '{print $1}')" = "$gate_hash"
test "$("$staged_gate" prereqs)" = nftfw-ipv6-early
test ! -e "$DESTDIR/scripts/init-top/$vendor_alias" \
    -a ! -L "$DESTDIR/scripts/init-top/$vendor_alias"
copy_file script "$vendor_udev" "/scripts/init-top/$vendor_alias"
copy_file config "$rules" /etc/nftfw/initramfs-guard.nft
copy_file config "$marker" /etc/nftfw/initramfs-managed-disabled-v1
printf '%s  %s\n%s  %s\n' \
    "$(sha256sum "$rules" | awk '{print $1}')" /etc/nftfw/initramfs-guard.nft \
    "$(sha256sum "$vendor_udev" | awk '{print $1}')" "/scripts/init-top/$vendor_alias" \
    >"$DESTDIR/etc/nftfw/initramfs-guard.sha256"
chmod 0600 "$DESTDIR/etc/nftfw/initramfs-guard.sha256"
