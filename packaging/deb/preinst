#!/bin/sh
set -eu

state_dir=/var/lib/nftfw
database=$state_dir/generation-state/state.db
runtime_dir=/run/nftfw
legacy_cutoff='2.0.2~'
package_version='@VERSION@'
package_commit='@COMMIT@'
package_build_disposition='@BUILD_DISPOSITION@'
required_schema_history='1,2,3,4,5,6'
version_placeholder='@''VERSION@'
commit_placeholder='@''COMMIT@'
build_disposition_placeholder='@''BUILD_DISPOSITION@'
installed_binary=/usr/lib/nftfw/nftfw

if [ "$package_version" = "$version_placeholder" ] || \
    [ "$package_commit" = "$commit_placeholder" ] || \
    [ "$package_build_disposition" = "$build_disposition_placeholder" ]; then
    echo "NFT Firewall package version/commit/disposition was not substituted safely" >&2
    exit 1
fi
case "$package_commit" in
    *[!0-9a-f]*|'')
        echo "NFT Firewall package commit identity is malformed" >&2
        exit 1
        ;;
esac
if [ "${#package_commit}" -ne 40 ]; then
    echo "NFT Firewall package commit identity is not a full 40-hex hash" >&2
    exit 1
fi

installed_binary_identity() {
    identity_output=$("$installed_binary" version 2>/dev/null) || return 1
    identity_first_line=$(printf '%s\n' "$identity_output" | sed -n '1p')
    [ -n "$identity_output" ] && [ "$identity_output" = "$identity_first_line" ] || return 1
    IFS=' ' read -r identity_label identity_version identity_marker identity_commit \
        identity_built identity_date identity_extra <<EOF
$identity_output
EOF
    [ "$identity_label" = nftfw ] && [ "$identity_marker" = '(commit' ] && \
        [ "$identity_built" = built ] && [ -z "$identity_extra" ] || return 1
    case "$identity_commit" in *,) ;; *) return 1 ;; esac
    case "$identity_date" in *')') ;; *) return 1 ;; esac
    identity_commit=${identity_commit%,}
    case "$identity_commit" in *[!0-9a-f]*|'') return 1 ;; esac
    [ "${#identity_commit}" -eq 40 ] || return 1
    dpkg --validate-version "$identity_version" >/dev/null 2>&1 || return 1
    printf '%s %s\n' "$identity_version" "$identity_commit"
}

action=${1:-}
case "$action" in
    install|upgrade) ;;
    # Abort/recovery invocations must not introduce another failure while dpkg
    # is restoring the previously installed package state.
    *) exit 0 ;;
esac
case "$package_version" in
    *~stage.r.*)
        echo "Refusing an NFT Firewall Stage R candidate package version." >&2
        echo "Stage R candidate packages are intrinsically non-installable." >&2
        exit 1
        ;;
esac
if [ "$package_build_disposition" != release ]; then
    echo "Refusing non-release NFT Firewall package (build disposition: $package_build_disposition)." >&2
    echo "Development, CI, and Stage R candidate packages are intrinsically non-installable." >&2
    exit 1
fi

# A dpkg "install" can still encounter state retained after an older package
# was removed. Refuse it before the fresh-install fast path: 2.0.2 must never
# adopt or rewrite the legacy database without the reviewed migration tool.
if [ -e "$state_dir/state.db" ] || [ -L "$state_dir/state.db" ]; then
    echo "Refusing legacy state at $state_dir/state.db; no 2.0.2 migration was executed." >&2
    exit 1
fi

unit_names='nftfw-early.service nftfw-enforcement-ready.service nftfw-rollback.service nftfw-rollback.timer nftfw-web.service nftfwd.service'
for shadow_root in /etc/systemd/system /run/systemd/system /usr/local/lib/systemd/system; do
    for unit_name in $unit_names; do
        shadow=$shadow_root/$unit_name
        if [ -e "$shadow" ] || [ -L "$shadow" ]; then
            echo "Refusing a package install/upgrade shadowed by an unmanaged full unit: $shadow" >&2
            echo "Use reviewed drop-ins with the packaged vendor unit instead." >&2
            exit 1
        fi
    done
done

old_version=${2:-}
case "$action" in
    upgrade)
        ;;
    install)
        # With no prior version, a canonical database is retained state whose
        # schema/package provenance cannot be established.  Never adopt it as
        # a fresh 2.0.2 installation.
        if [ -z "$old_version" ]; then
            for retained in \
                "$database" \
                "$state_dir/enforcement-enabled" \
                "$state_dir/provenance-ledger.db" \
                /usr/lib/nftfw/nftfw \
                /usr/lib/systemd/system/nftfwd.service; do
                if [ -e "$retained" ] || [ -L "$retained" ]; then
                    echo "Refusing retained or shadowing NFTFW state on a fresh install: $retained" >&2
                    echo "A separately reviewed recovery/import contract is required." >&2
                    exit 1
                fi
            done
            exit 0
        fi
        ;;
esac

if [ -z "$old_version" ] || ! command -v dpkg >/dev/null 2>&1; then
    echo "Cannot establish the installed NFT Firewall version safely" >&2
    exit 1
fi
if dpkg --compare-versions "$old_version" lt "$legacy_cutoff"; then
    echo "Refusing an in-place upgrade from NFT Firewall V2 $old_version." >&2
    echo "Pre-2.0.2 state requires the separately reviewed offline migration command and contract." >&2
    echo "The upgrade is stopped before dpkg can invoke the legacy prerm, which may stop active NFTFW units." >&2
    exit 1
fi
if dpkg --compare-versions "$old_version" gt "$package_version"; then
    echo "Refusing to downgrade NFT Firewall V2 from $old_version to $package_version." >&2
    echo "A newer generation schema must not be opened by an older package." >&2
    exit 1
fi
if dpkg --compare-versions "$old_version" eq "$package_version"; then
    if [ -L "$installed_binary" ] || [ ! -f "$installed_binary" ] || \
        [ ! -x "$installed_binary" ] || \
        [ "$(find "$installed_binary" -maxdepth 0 -type f -uid 0 ! -perm /022 -print -quit)" != "$installed_binary" ]; then
        echo "Refusing a same-version reinstall: the installed NFTFW binary is missing or unprotected." >&2
        exit 1
    fi
    installed_identity=$(installed_binary_identity) || {
        echo "Refusing a same-version reinstall with an unknown installed version/commit identity." >&2
        exit 1
    }
    IFS=' ' read -r installed_identity_version installed_identity_commit \
        installed_identity_extra <<EOF
$installed_identity
EOF
    if [ -n "$installed_identity_extra" ] || \
        [ "$installed_identity_version" != "$old_version" ] || \
        [ "$installed_identity_commit" != "$package_commit" ]; then
        echo "Refusing a same-version NFT Firewall overwrite from a different or unknown commit." >&2
        exit 1
    fi
fi

for directory in "$state_dir" "$state_dir/generation-state" "$state_dir/backups"; do
    if [ -L "$directory" ] || { [ -e "$directory" ] && [ ! -d "$directory" ]; }; then
        echo "Refusing unsafe state directory: $directory" >&2
        exit 1
    fi
done
if [ -L "$database" ]; then
    echo "Refusing to upgrade with a symlinked state database: $database" >&2
    exit 1
fi
if [ ! -e "$database" ]; then
    exit 0
fi
if [ ! -f "$database" ] || [ ! -s "$database" ]; then
    echo "Refusing an unsafe or empty state database: $database" >&2
    exit 1
fi
if ! command -v sqlite3 >/dev/null 2>&1; then
    echo "Cannot prove exact NFTFW state schema 6: sqlite3 is unavailable." >&2
    exit 1
fi
schema_history=$(
    sqlite3 -batch -noheader "file:$database?mode=ro&immutable=1" \
        "SELECT group_concat(version, ',') FROM (SELECT version FROM schema_migrations ORDER BY version);" \
        2>/dev/null
) || {
    echo "Cannot read the canonical database migration history without mutation." >&2
    exit 1
}
if [ "$schema_history" != "$required_schema_history" ]; then
    echo "Refusing canonical state whose migration history is not exactly schema 1..6: $database" >&2
    echo "No implicit state migration was executed." >&2
    exit 1
fi

install -d -o root -g root -m 0700 "$state_dir/backups"
stamp=$(date -u +%Y%m%dT%H%M%SZ)
backup="$state_dir/backups/state-before-package-upgrade-$stamp-$$.db"
if [ -e "$backup" ] || [ -L "$backup" ]; then
    echo "Refusing to overwrite an existing pre-upgrade backup: $backup" >&2
    exit 1
fi

if ! getent group nftfw-web >/dev/null 2>&1; then
    echo "Cannot establish the nftfw-web group required by the canonical mutation-lock directory." >&2
    exit 1
fi
if [ -L "$runtime_dir" ] || { [ -e "$runtime_dir" ] && [ ! -d "$runtime_dir" ]; }; then
    echo "Refusing unsafe mutation-lock directory: $runtime_dir" >&2
    exit 1
fi
# The installed nonmigrating backup command takes the same canonical flock as
# daemon/apply/commit/rollback.  RuntimeDirectory may be absent while all units
# are stopped, so establish its exact package ownership without activating a
# unit.  A backup-command or lock failure is fatal; never bypass it with an
# unlocked sqlite3 fallback.
install -d -o root -g nftfw-web -m 0750 "$runtime_dir"
if [ -L "$installed_binary" ] || [ ! -f "$installed_binary" ] || \
    [ ! -x "$installed_binary" ] || \
    [ "$(find "$installed_binary" -maxdepth 0 -type f -uid 0 ! -perm /022 -print -quit)" != "$installed_binary" ]; then
    echo "Cannot safely back up existing state: the installed NFTFW binary is missing or unprotected." >&2
    exit 1
fi
if ! NFTFW_RUNTIME_DIR="$runtime_dir" NFTFW_STATE_DB='' \
    "$installed_binary" state backup "$backup" --database "$database"; then
    if [ -e "$backup" ] || [ -L "$backup" ]; then
        echo "Installed backup command failed after creating $backup; preserving it for diagnosis and stopping." >&2
    else
        echo "Installed backup command or canonical mutation lock failed; no unlocked fallback was attempted." >&2
    fi
    exit 1
fi
if ! NFTFW_RUNTIME_DIR="$runtime_dir" NFTFW_STATE_DB='' \
    "$installed_binary" state verify --database "$backup"; then
    echo "Pre-upgrade backup failed nonmutating verification; preserving $backup and stopping." >&2
    exit 1
fi
backup_schema_history=$(
    sqlite3 -batch -noheader "file:$backup?mode=ro&immutable=1" \
        "SELECT group_concat(version, ',') FROM (SELECT version FROM schema_migrations ORDER BY version);" \
        2>/dev/null
) || {
    echo "Pre-upgrade backup migration history is unreadable; preserving $backup and stopping." >&2
    exit 1
}
if [ "$backup_schema_history" != "$required_schema_history" ]; then
    echo "Pre-upgrade backup is not exact schema 6; preserving $backup and stopping." >&2
    exit 1
fi

echo "Verified pre-upgrade state backup: $backup"
