#!/bin/sh
set -eu

state_dir=/var/lib/nftfw
database=$state_dir/state.db

case "${1:-}" in
    upgrade)
        ;;
    *)
        exit 0
        ;;
esac

if [ -L "$database" ]; then
    echo "Refusing to upgrade with a symlinked state database: $database" >&2
    exit 1
fi
if [ ! -s "$database" ]; then
    exit 0
fi
if [ -L "$state_dir" ] || [ -L "$state_dir/backups" ]; then
    echo "Refusing to upgrade with a symlinked state directory" >&2
    exit 1
fi

install -d -o root -g root -m 0700 "$state_dir/backups"
stamp=$(date -u +%Y%m%dT%H%M%SZ)
backup="$state_dir/backups/state-before-package-upgrade-$stamp-$$.db"

if [ -x /usr/lib/nftfw/nftfw ] && \
    /usr/lib/nftfw/nftfw state backup "$backup" --database "$database"; then
    :
elif command -v sqlite3 >/dev/null 2>&1; then
    rm -f "$backup"
    sqlite3 "$database" ".timeout 5000" ".backup '$backup'"
    chmod 0600 "$backup"
    if [ "$(sqlite3 "$backup" 'PRAGMA quick_check;')" != ok ]; then
        rm -f "$backup"
        echo "Pre-upgrade SQLite backup failed verification" >&2
        exit 1
    fi
else
    rm -f "$backup"
    echo "Cannot safely back up existing state; install sqlite3 and retry" >&2
    exit 1
fi

echo "Verified pre-upgrade state backup: $backup"
