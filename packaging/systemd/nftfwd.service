[Unit]
Description=NFT Firewall V2 privileged reconciler
StartLimitIntervalSec=60s
StartLimitBurst=20
After=local-fs.target network-pre.target
Wants=network-pre.target
Before=network.target

[Service]
Type=simple
ExecStart=/usr/lib/nftfw/nftfwd --config /etc/nftfw/nftfw.toml --status-socket /run/nftfw/status.sock --control-socket /run/nftfw/control.sock
Restart=on-failure
RestartSec=2s
User=root
Group=nftfw-web
RuntimeDirectory=nftfw
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/nftfw /run/nftfw
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
