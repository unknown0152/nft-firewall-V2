[Unit]
Description=Verify restored NFTFW enforcement before network consumers
Documentation=file:/usr/share/doc/nft-firewall-v2/RECOVERY.md
DefaultDependencies=no
After=local-fs.target nftfw-early.service
Before=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/lib/nftfw/nftfwd --verify-enforcement --state-dir /var/lib/nftfw
RemainAfterExit=yes
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/run/nftfw
ReadOnlyPaths=/var/lib/nftfw
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN

[Install]
RequiredBy=network-pre.target
