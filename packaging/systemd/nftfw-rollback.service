[Unit]
Description=NFT Firewall V2 expired safe-apply rollback
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/lib/nftfw/nftfwd --rollback-expired --state-dir /var/lib/nftfw
RuntimeDirectory=nftfw
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
User=root
Group=nftfw-web
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/nftfw/generation-state /run/nftfw
ReadOnlyPaths=/etc/nftfw /var/lib/nftfw/provenance-ledger.db -/var/lib/nftfw/provenance-ledger.db-journal -/var/lib/nftfw/provenance-ledger.db-wal -/var/lib/nftfw/provenance-ledger.db-shm /var/lib/nftfw/generations /var/lib/nftfw/backups -/var/lib/nftfw/active.snapshot.json -/var/lib/nftfw/enforcement-enabled
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
